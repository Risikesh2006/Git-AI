# ============================================================
# Git AI - Backend Environment Variables
# ============================================================

# Server
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/callback

# LM Studio (Local LLM)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# JWT (for additional security layer)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Cloud LLM fallback, used when LM Studio is unreachable. Gemini (free tier) is
# preferred automatically when both keys are set — override with CLOUD_LLM_PROVIDER
# ('gemini' | 'anthropic') to force one. Leave both blank to disable cloud fallback.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key
CLOUD_LLM_MODEL=claude-sonnet-5
CLOUD_LLM_PROVIDER=

# ML priority-scoring microservice (see ml-service/) — falls back to the JS heuristic if unset/unreachable
ML_SERVICE_URL=http://localhost:5001

# GitHub token encryption at rest — 32-byte key, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
